<%- include('includes/header', { pageTitle: 'Venturo Admin | Products' }) %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <%- include('includes/admin-nav', { activePage: 'products' }) %>

    <div class="catalog-frame">
      <div class="board">
        <div class="dishes-table">
          <span class="new-dish-txt" style="margin-bottom: 30px">
            PRODUCT CATALOG
          </span>
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">#</th>
                <th scope="col">Product Name</th>
                <th scope="col">Collection</th>
                <th scope="col">Product Size</th>
                <th scope="col">Product Price</th>
                <th scope="col">Inventory</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>

              <% products.map(function(value, key){ %>
            <tbody style="background: white">
              <td><%= key + 1 %></td>
              <td><%= value.productName %></td>
              <td><%= value.productCollection %></td>
              <td><%= value.productSize || '-' %></td>
              <td><%= value.productPrice %></td>
              <td><%= value.productLeftCount %></td>
              <td>
                <select class="spec-select new-product-status" id="<%= value._id %>">
                  <option value="PAUSE" <%= value.productStatus === 'PAUSE' ? 'selected': '' %> >PAUSE</option>
                  <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected': '' %> >PROCESS</option>
                  <option value="DELETE" <%= value.productStatus === 'DELETE' ? 'selected': '' %> >DELETE</option>
                </select>
              </td>
              <td>
                <button
                  type="button"
                  class="btn product-edit-button"
                  data-product-id="<%= value._id %>"
                >
                  Edit
                </button>
              </td>
            </tbody>
              <% }) %>
          
          </table>
          <script id="product-edit-data" type="application/json"><%- JSON.stringify(products).replace(/</g, "\\u003c") %></script>
          <div
            class="long-input"
            style="align-items: flex-end; margin-bottom: 25px"
          >
            <button class="btn btn-primary" id="process-btn">
              New Product
            </button>
          </div>
        </div>
        <form
        onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          class="dish-container"
          enctype="multipart/form-data"
        >
          <div class="long-input" style="display: flex; align-items: center">
            <span class="new-dish-txt">NEW PRODUCT DETAIL</span>
          </div>
          <div class="login-input-frame">
            <div class="long-input">
              <label>Product Name</label>
              <input
                type="text"
                placeholder="Name"
                name="productName"
                class="product-name"
              />
            </div>
            <input
              name="productStatus"
              value="PAUSE"
              class="product-status"
              hidden
            />
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label>Product Price</label>
              <input
                type="number"
                placeholder="Price"
                name="productPrice"
                class="product-price"
              />
            </div>
            <div class="half-input">
              <label>Product Left Counts</label>
              <input
                type="number"
                placeholder="Counts"
                name="productLeftCount"
                class="product-left-count"
              />
            </div>
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label>Product Type</label>
              <select class="product-collection" name="productCollection">
                <option value="CLIMBING" selected>Climbing</option>
                <option value="CAMPING">Camping</option>
                <option value="HIKING">Hiking</option>
                <option value="TREKKING">Trekking</option>
                <option value="CYCLING">Cycling</option>
                <option value="APPAREL">Apparel</option>
                <option value="FOOTWEAR">Footwear</option>
                <option value="OTHER">Other</option>
              </select>
            </div>

            <div class="half-input" id="product-size-field">
              <label>Size</label>
              <select class="product-size" name="productSize">
                <option value="SMALL">Small</option>
                <option value="NORMAL" selected>Normal</option>
                <option value="LARGE">Large</option>
                <option value="SET">Set</option>
              </select>
            </div>
          </div>
          <div class="long-input">
            <label>Product Description</label>
            <textarea name="productDesc" class="product-desc"></textarea>
          </div>

          <div class="img-frame">
            <label>Product Images</label>
            <div class="media-frame">
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="1" id="image-section-1" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-one"
                  required
                  onchange="previewFileHandler(this, 1)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="2" id="image-section-2" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-two"
                  onchange="previewFileHandler(this, 2)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="3" id="image-section-3" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-three"
                  onchange="previewFileHandler(this, 3)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="4" id="image-section-4" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-four"
                  onchange="previewFileHandler(this, 4)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="5" id="image-section-5" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-five"
                  onchange="previewFileHandler(this, 5)"
                />
              </div>
            </div>
          </div>

          <div class="operation-buttons">
            <button class="btn btn-danger" id="cancel-btn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="create-btn">
              Create
            </button>
          </div>
        </form>

        <div class="product-edit-modal" id="product-edit-modal" hidden>
          <div class="product-edit-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="product-edit-title">
            <div class="product-edit-modal__header">
              <div>
                <span class="product-edit-modal__eyebrow">PRODUCT INFORMATION</span>
                <h2 id="product-edit-title">Edit Product</h2>
              </div>
              <button type="button" class="product-edit-modal__close" id="product-edit-cancel" aria-label="Close edit product form">&times;</button>
            </div>

            <form id="product-edit-form" novalidate>
              <p class="product-edit-modal__notice">Images are unchanged in this editor.</p>
              <div class="long-input">
                <label for="edit-product-name">Product Name</label>
                <input id="edit-product-name" type="text" required />
              </div>
              <div class="half-input-frame">
                <div class="half-input">
                  <label for="edit-product-price">Product Price</label>
                  <input id="edit-product-price" type="number" min="0" step="any" required />
                </div>
                <div class="half-input">
                  <label for="edit-product-left-count">Inventory</label>
                  <input id="edit-product-left-count" type="number" min="0" step="any" required />
                </div>
              </div>
              <div class="half-input-frame">
                <div class="half-input">
                  <label for="edit-product-collection">Product Type</label>
                  <select id="edit-product-collection" required>
                    <option value="CLIMBING">Climbing</option>
                    <option value="CAMPING">Camping</option>
                    <option value="HIKING">Hiking</option>
                    <option value="TREKKING">Trekking</option>
                    <option value="CYCLING">Cycling</option>
                    <option value="APPAREL">Apparel</option>
                    <option value="FOOTWEAR">Footwear</option>
                    <option value="OTHER">Other</option>
                  </select>
                </div>
                <div class="half-input">
                  <label for="edit-product-size">Size</label>
                  <select id="edit-product-size">
                    <option value="">No size</option>
                    <option value="SMALL">Small</option>
                    <option value="NORMAL">Normal</option>
                    <option value="LARGE">Large</option>
                    <option value="SET">Set</option>
                  </select>
                </div>
              </div>
              <div class="long-input">
                <label for="edit-product-desc">Product Description</label>
                <textarea id="edit-product-desc" required></textarea>
              </div>
              <div class="long-input">
                <label for="edit-product-status">Status</label>
                <select id="edit-product-status" required>
                  <option value="PAUSE">PAUSE</option>
                  <option value="PROCESS">PROCESS</option>
                  <option value="DELETE">DELETE</option>
                </select>
              </div>
              <div class="operation-buttons">
                <button type="button" class="btn btn-danger" id="edit-product-close">Cancel</button>
                <button type="submit" class="btn btn-primary" id="edit-product-save">Save Changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
