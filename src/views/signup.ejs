<%- include('includes/header', { pageTitle: 'Venturo Admin | Signup' }) %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <main class="auth-page">
  <div class="signup-container">
    <form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST" enctype="multipart/form-data">
      <div class="signup-frame">
        <div class="auth-brand"><span>V</span> VENTURO <small>ADMIN</small></div>
        <div class="signup-top">
          <span>Create Admin Account</span>
          <div>Create the first active Venturo administrator.</div>
          <p>
            Already have an account?
            <a href="/admin/login">Login</a>
          </p>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Admin username *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Username"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>Phone number *</label>
            <input
              type="text"
              name="memberPhone"
              class="member-phone"
              placeholder="Phone"
              value=""
            />
          </div>
        </div>
        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>Repeat password *</label>
            <input
              type="password"
              name="confirmPassword"
              class="confirm-password"
              placeholder="Repeat password"
              value=""
            />
          </div>
        </div>

        <div class="signup-input-frame">
          <div class="media-frame">
            <img class="upload-img-frame" src="/img/upload.svg" alt="Profile image preview" />
            <div class="upload-container">
              <span class="media-text">Profile image *</span>
              <div
                class="file-box bs3-primary preview-image"
                style="margin-top: 25px; display: flex"
              >
                <input
                  class="upload-name"
                  value="Choose image"
                  disabled="disabled"
                />
                <label for="input-file" class="file-input-label"
                  >Upload Image</label
                >
                <input
                  type="file"
                  id="input-file"
                  class="upload-hidden form-control-file member-image"
                  name="memberImage"
                />
              </div>
              <p class="thumbnail-desc">
                Upload a profile image for this administrator.<br />
                JPG, JPEG, PNG, or WEBP formats are supported.
              </p>
            </div>
          </div>
        </div>

        <input name="memberType" value="ADMIN" hidden />

        <button class="signup-btn btn" name="signup" type="submit">
          Create admin account
        </button>
      </div>
    </form>
  </div>
  </main>



  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
