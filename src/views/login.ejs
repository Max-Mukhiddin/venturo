<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <main class="auth-page">
  <form class="login-container" action="/admin/login" method="POST">
    <div class="login-frame">
      <div class="auth-brand"><span>V</span> VENTURO <small>ADMIN</small></div>
      <div class="login-top">
        <span>Admin Login</span>
        <p>Sign in to manage the Venturo catalog and member workspace.</p>
      </div>
      <div class="login-input-frame">
        <div class="login-input-container">
          <label>Admin username</label>
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Enter your username"
            value=""
            required
          />
        </div>
        <div class="login-input-container">
          <label>Password</label>
          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Enter your password"
            value=""
            required
          />
        </div>
      </div>
      <button class="login-btn btn" name="login" type="submit">Sign in</button>
      <div class="auth-footer">Need the initial administrator? <a href="/admin/signup">Create admin account</a></div>
    </div>
  </form>
  </main>
</body>

<%- include('includes/footer') %>
